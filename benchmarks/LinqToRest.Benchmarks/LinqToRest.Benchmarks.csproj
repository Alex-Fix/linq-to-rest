<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <!-- The integration tests' shop (entities, sets, policies); its test-only database helpers stay out. -->
    <Compile Include="..\..\tests\LinqToRest.Server.IntegrationTests\Shop\*.cs" Exclude="..\..\tests\LinqToRest.Server.IntegrationTests\Shop\ShopDatabase.cs" LinkBase="Shop" />
    <!-- The golden model the client benchmarks bind to the test contracts. -->
    <Content Include="..\..\tests\golden\model.json" Link="golden\model.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tests\LinqToRest.Server.IntegrationTests\Shop\model.json" Link="Shop\model.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LinqToRest.Client\LinqToRest.Client.csproj" />
    <ProjectReference Include="..\..\src\LinqToRest.Server\LinqToRest.Server.csproj" />
    <ProjectReference Include="..\..\src\LinqToRest.CodeGen\LinqToRest.CodeGen.csproj" />
  </ItemGroup>
</Project>
