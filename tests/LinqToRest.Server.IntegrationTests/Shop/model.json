        {"name": "createdAt", "type": "dateTime", "writable": true, "sortable": true},
        {"name": "releasedOn", "type": "dateOnly", "nullable": true, "writable": true, "sortable": true},
        {"name": "rating", "type": "float64", "writable": true, "filterable": false, "aggregatable": true},
        {"name": "isFeatured", "type": "bool", "writable": true},
        {"name": "categoryId", "type": "int32", "nullable": true, "writable": true, "groupable": true},
        {"name": "size", "type": "Dimensions", "writable": true},
