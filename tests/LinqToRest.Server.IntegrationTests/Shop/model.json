        {"name": "unitPrice", "type": "decimal"},
        {"name": "shipping", "type": "Place", "nullable": true, "filterable": false}
      ],
      "navigations": []
    },
    {
      "name": "products",
      "type": "Product",
      "key": ["id"],
      "concurrencyToken": "version",
      "writes": ["insert", "update", "delete"],
      "pagination": {"modes": ["offset", "cursor"], "defaultPageSize": 10, "maxPageSize": 20, "maxSkip": 100},
      "properties": [
        {"name": "id", "type": "int32", "sortable": true},
        {"name": "name", "type": "string", "writable": true, "rules": {"maxLength": 100}},
