{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet pack:*)",
      "Bash(dotnet list package:*)",
      "Bash(dotnet jb inspectcode:*)",
      "Bash(dotnet tool restore)",
      "Bash(dotnet --version)",
      "Bash(dotnet --list-sdks)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./**/.env)"
    ]
  }
}
