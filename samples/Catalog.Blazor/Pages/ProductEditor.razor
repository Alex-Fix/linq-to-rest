@page "/products/new"
@page "/products/{Id:int}/edit"
@inject Session Session
@inject NavigationManager Navigation

@if (!Session.IsEditor)
{
    <Result Status="ResultStatus.Http403" Title="Editors only" SubTitle="Sign in as an editor to change products." />
}
else if (_form is null)
{
    @if (_error is null)
    {
        <Skeleton Active />
    }
    else
    {
        <Alert Type="AlertType.Error" ShowIcon="true" Message="@_error" />
    }
}
else
{
    <Card Title="@(Id is null ? "New product" : $"Edit {_loaded?.Product.Name}")" Style="max-width: 900px; margin: 0 auto">
        <Form Model="_form" Layout="@FormLayout.Vertical" OnFinish="() => SaveAsync(_loaded)">
            <GridRow Gutter="16">
                <GridCol Xs="24" Md="8">
                    <FormItem Label="SKU" Required="@(_rules.Sku?.IsRequired == true)" Extra="Capitals, digits and dashes." @attributes="Help(nameof(Product.Sku))">
                        <Input @bind-Value="_form.Sku" @bind-Value:after="() => Touch(nameof(Product.Sku))" />
                    </FormItem>
                </GridCol>
                <GridCol Xs="24" Md="16">
                    <FormItem Label="Name" Required="@(_rules.Name?.IsRequired == true)" @attributes="Help(nameof(Product.Name))">
                        <Input @bind-Value="_form.Name" @bind-Value:after="() => Touch(nameof(Product.Name))" MaxLength="@(_rules.Name?.MaxLength ?? -1)" ShowCount />
                    </FormItem>
                </GridCol>
            </GridRow>
            <FormItem Label="Description" @attributes="Help(nameof(Product.Description))">
                <TextArea Rows="3" @bind-Value="_form.Description" @bind-Value:after="() => Touch(nameof(Product.Description))" MaxLength="@(_rules.Description?.MaxLength ?? -1)" />
            </FormItem>
            <GridRow Gutter="16">
                <GridCol Xs="12" Md="6">
                    <FormItem Label="Price" @attributes="Help(nameof(Product.Price))">
                        <AntDesign.InputNumber TValue="decimal" Step="0.01m" Style="width: 100%" @bind-Value="_form.Price" @bind-Value:after="() => Touch(nameof(Product.Price))" />
                    </FormItem>
                </GridCol>
                <GridCol Xs="12" Md="6">
                    <FormItem Label="Stock" @attributes="Help(nameof(Product.Stock))">
                        <AntDesign.InputNumber TValue="int" Style="width: 100%" @bind-Value="_form.Stock" @bind-Value:after="() => Touch(nameof(Product.Stock))" />
                    </FormItem>
                </GridCol>
                <GridCol Xs="24" Md="12">
                    <FormItem Label="Status"><EnumSelect TEnum="ProductStatus" @bind-Value="_form.Status" /></FormItem>
                </GridCol>
            </GridRow>
            <GridRow Gutter="16">
                <GridCol Xs="24" Md="12">
                    <FormItem Label="Category">
                        <Select TItem="CategoryNode" TItemValue="int" DataSource="_categories" ItemValue="item => item.Id" ItemLabel="item => item.Name"
                                @bind-Value="_form.CategoryId" EnableSearch />
                    </FormItem>
                </GridCol>
                <GridCol Xs="24" Md="12">
                    <FormItem Label="Brand">
                        <Select TItem="BrandRow" TItemValue="int" DataSource="_brands" ItemValue="item => item.Id" ItemLabel="item => item.Name"
                                @bind-Value="_form.BrandId" />
                    </FormItem>
                </GridCol>
            </GridRow>
            <FormItem Label="Images" Extra="The first image is the card image.">
                @for (var index = 0; index < _form.Images.Count; index++)
                {
                    var position = index;
                    var row = _form.Images[position];
                    <div @key="row" style="display: flex; gap: 8px; margin-bottom: 8px">
                        <Input Placeholder="https://…" @bind-Value="row.Url" @bind-Value:after="() => _imageErrors.Remove(row)" Status="@(_imageErrors.ContainsKey(row) ? FormValidateStatus.Error : FormValidateStatus.Default)" />
                        <Button Icon="arrow-up" Disabled="@(position == 0)" OnClick="() => Move(position, -1)" />
                        <Button Icon="arrow-down" Disabled="@(position == _form.Images.Count - 1)" OnClick="() => Move(position, 1)" />
                        <Button Danger Icon="delete" OnClick="() => _form.Images.Remove(row)" />
                    </div>
                    @if (_imageErrors.TryGetValue(row, out var imageError))
                    {
                        <div style="margin: -4px 0 8px"><Text Type="TextElementType.Danger">@imageError</Text></div>
                    }
                }
                <Button Type="ButtonType.Dashed" Block Icon="plus" OnClick="() => _form.Images.Add(new ImageRow(null, string.Empty))">Add image</Button>
            </FormItem>
            @if (_error is not null)
            {
                <Alert Type="@(_conflict ? AlertType.Warning : AlertType.Error)" ShowIcon="true" Message="@_error" Style="margin-bottom: 16px" />
            }
            <Space>
                <SpaceItem><Button Type="ButtonType.Primary" HtmlType="submit" Loading="_saving">Save</Button></SpaceItem>
                @if (_conflict)
                {
                    <SpaceItem><Button Icon="reload" Disabled="_saving" OnClick="ReloadAndReapplyAsync">Reload and reapply my changes</Button></SpaceItem>
                }
            </Space>
        </Form>
    </Card>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private Loaded? _loaded;
    private EditorForm? _form;
    private List<CategoryNode> _categories = [];
    private List<BrandRow> _brands = [];
    private string? _error;
    private bool _conflict;
    private bool _saving;
    private Rules _rules = null!;
    private readonly HashSet<string> _touched = [];
    private Dictionary<string, IReadOnlyList<string>> _serverErrors = [];
    private Dictionary<ImageRow, string> _imageErrors = [];

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var catalog = Session.NewCatalog();
            _rules = new Rules(catalog);
            _categories = await catalog.Categories.OrderBy(c => c.Name).Select(c => new CategoryNode(c.Id, c.Name, c.ParentId, c.ProductCount)).Take(200).ToListAsync();
            _brands = await catalog.Brands.OrderBy(b => b.Name).Select(b => new BrandRow(b.Id, b.Name, b.ProductCount)).Take(100).ToListAsync();
            _loaded = Id is { } id ? await LoadAsync(id) : null;
            _form = _loaded is null
                ? new EditorForm { CategoryId = _categories.FirstOrDefault()?.Id ?? 0, BrandId = _brands.FirstOrDefault()?.Id ?? 0 }
                : EditorForm.Of(_loaded);
        }
        catch (Exception exception) when (exception is RestQueryException or HttpRequestException)
        {
            _error = Errors.Describe(exception);
        }
    }

    private async Task<Loaded?> LoadAsync(int id)
    {
        var catalog = Session.NewCatalog();
        var product = await catalog.Products.AsNoTracking().FirstOrDefaultAsync(p => p.Id == id);
        return product is null
            ? null
            : new Loaded(product, await catalog.ProductImages.AsNoTracking().Where(i => i.ProductId == id).OrderBy(i => i.SortOrder).Take(50).ToListAsync());
    }

    /// <summary>
    /// One save is one batch: the product and every image change. The unit of work starts from the rows as the editor
    /// loaded them, so a change made elsewhere in the meantime fails with a concurrency conflict instead of being lost.
    /// </summary>
    private async Task SaveAsync(Loaded? baseline)
    {
        (_saving, _error, _conflict, _serverErrors, _imageErrors) = (true, null, false, [], []);
        var rows = new Dictionary<object, ImageRow>(ReferenceEqualityComparer.Instance);
        Product? saved = null;
        try
        {
            var catalog = Session.NewCatalog();
            Product product;
            var existing = new Dictionary<int, ProductImage>();
            if (baseline is null)
            {
                product = new Product();
                catalog.Products.Add(product);
                saved = product;
            }
            else
            {
                product = Copy(baseline.Product);
                catalog.Products.Attach(product);
                saved = product;
                foreach (var image in baseline.Images)
                {
                    var tracked = new ProductImage { Id = image.Id, ProductId = image.ProductId, Url = image.Url, SortOrder = image.SortOrder };
                    catalog.ProductImages.Attach(tracked);
                    existing.Add(image.Id, tracked);
                }
            }

            _form!.ApplyTo(product);
            for (var sortOrder = 0; sortOrder < _form.Images.Count; sortOrder++)
            {
                var row = _form.Images[sortOrder];
                if (row.Id is { } imageId && existing.Remove(imageId, out var image))
                {
                    (image.Url, image.SortOrder) = (row.Url, sortOrder);
                    rows.Add(image, row);
                }
                else
                {
                    // A new image points at the product; for a new product that becomes a ref in the batch.
                    var added = new ProductImage { Url = row.Url, SortOrder = sortOrder, Product = product };
                    catalog.ProductImages.Add(added);
                    rows.Add(added, row);
                }
            }

            foreach (var removed in existing.Values)
            {
                catalog.ProductImages.Remove(removed);
            }

            await catalog.SaveChangesAsync();
            Navigation.NavigateTo($"products/{product.Id}");
        }
        catch (RestValidationException exception)
        {
            // Errors from the client's check or the server's 422 name tracked entities: place them on the fields.
            _error = Errors.Describe(exception);
            _touched.UnionWith(Members);
            _serverErrors = saved is null ? [] : exception.ErrorsFor(saved).ToDictionary();
            _imageErrors = rows
                .Where(pair => exception.ErrorsFor(pair.Key).Count > 0)
                .ToDictionary(pair => pair.Value, pair => string.Join(" ", exception.ErrorsFor(pair.Key).SelectMany(codes => codes.Value).Select(code => Errors.FieldMessage(code, _rules.Url))));
        }
        catch (RestSaveException exception)
        {
            (_conflict, _error) = (exception is RestConcurrencyException, Errors.Describe(exception));
        }
        catch (HttpRequestException exception)
        {
            _error = Errors.Describe(exception);
        }
        finally
        {
            _saving = false;
        }
    }

    // Keeps what the editor typed and applies it on top of the current row (with its new concurrency token).
    private async Task ReloadAndReapplyAsync()
    {
        if (Id is not { } id)
        {
            return;
        }

        _loaded = await LoadAsync(id);
        if (_loaded is null)
        {
            _error = "The product was deleted meanwhile.";
            return;
        }

        await SaveAsync(_loaded);
    }

    private static readonly string[] Members = [nameof(Product.Sku), nameof(Product.Name), nameof(Product.Description), nameof(Product.Price), nameof(Product.Stock)];

    private void Touch(string member)
    {
        _touched.Add(member);
        _serverErrors.Remove(member);
    }

    /// <summary>
    /// The model's rules on the row the form would save, for touched fields, plus what the last save reported: as
    /// the FormItem's error status and help.
    /// </summary>
    private Dictionary<string, object> Help(string member)
    {
        var product = new Product();
        _form!.ApplyTo(product);
        var codes = _rules.Catalog.Validate(product)
            .Where(error => error.Member == member && _touched.Contains(member))
            .Select(error => error.Code)
            .Concat(_serverErrors.GetValueOrDefault(member) ?? [])
            .Distinct()
            .ToList();
        return codes.Count == 0
            ? []
            : new Dictionary<string, object>
            {
                ["ValidateStatus"] = FormValidateStatus.Error,
                ["Help"] = string.Join(" ", codes.Select(code => Errors.FieldMessage(code, _rules.For(member)))),
            };
    }

    private void Move(int index, int offset)
    {
        var row = _form!.Images[index];
        _form.Images.RemoveAt(index);
        _form.Images.Insert(index + offset, row);
    }

    private static Product Copy(Product product) => new()
    {
        Id = product.Id,
        Sku = product.Sku,
        Name = product.Name,
        Description = product.Description,
        Price = product.Price,
        Status = product.Status,
        Stock = product.Stock,
        CategoryId = product.CategoryId,
        BrandId = product.BrandId,
        CreatedAt = product.CreatedAt,
        Version = product.Version,
    };

    private sealed record Loaded(Product Product, List<ProductImage> Images);

    /// <summary>The model's built-in rules the form uses: required marks, max lengths and message limits.</summary>
    private sealed class Rules(CatalogContext catalog)
    {
        /// <summary>Gets a context for checking rows locally; nothing is tracked or sent through it.</summary>
        public CatalogContext Catalog { get; } = catalog;

        public RestPropertyRules? Sku { get; } = catalog.Products.Rules(p => p.Sku);

        public RestPropertyRules? Name { get; } = catalog.Products.Rules(p => p.Name);

        public RestPropertyRules? Description { get; } = catalog.Products.Rules(p => p.Description);

        public RestPropertyRules? Price { get; } = catalog.Products.Rules(p => p.Price);

        public RestPropertyRules? Stock { get; } = catalog.Products.Rules(p => p.Stock);

        public RestPropertyRules? Url { get; } = catalog.ProductImages.Rules(i => i.Url);

        public RestPropertyRules? For(string member) => member switch
        {
            nameof(Product.Sku) => Sku,
            nameof(Product.Name) => Name,
            nameof(Product.Description) => Description,
            nameof(Product.Price) => Price,
            nameof(Product.Stock) => Stock,
            _ => null,
        };
    }

    private sealed class ImageRow(int? id, string url)
    {
        public int? Id { get; } = id;

        public string Url { get; set; } = url;
    }

    private sealed class EditorForm
    {
        public string Sku { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Price { get; set; }
        public ProductStatus Status { get; set; } = ProductStatus.Draft;
        public int Stock { get; set; }
        public int CategoryId { get; set; }
        public int BrandId { get; set; }
        public List<ImageRow> Images { get; } = [];

        public static EditorForm Of(Loaded loaded)
        {
            var product = loaded.Product;
            var form = new EditorForm
            {
                Sku = product.Sku,
                Name = product.Name,
                Description = product.Description ?? "",
                Price = product.Price,
                Status = product.Status,
                Stock = product.Stock,
                CategoryId = product.CategoryId,
                BrandId = product.BrandId,
            };
            form.Images.AddRange(loaded.Images.Select(image => new ImageRow(image.Id, image.Url)));
            return form;
        }

        public void ApplyTo(Product product)
        {
            product.Sku = Sku;
            product.Name = Name;
            product.Description = Description.Length == 0 ? null : Description;
            product.Price = Price;
            product.Status = Status;
            product.Stock = Stock;
            product.CategoryId = CategoryId;
            product.BrandId = BrandId;
        }
    }
}
