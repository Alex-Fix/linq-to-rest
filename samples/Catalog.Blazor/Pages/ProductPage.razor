@page "/products/{Id:int}"
@implements IDisposable
@inject Session Session

@if (_error is not null)
{
    <Alert Type="AlertType.Error" ShowIcon="true" Message="@_error" />
}
else if (!_loaded)
{
    <Skeleton Active />
}
else if (_product is null)
{
    <Result Status="ResultStatus.Http404" Title="Product not found" SubTitle="It doesn't exist, or you can't see it." />
}
else
{
    <Breadcrumb Style="margin-bottom: 16px">
        <BreadcrumbItem Href="">Catalog</BreadcrumbItem>
        <BreadcrumbItem>@_product.Category?.Name</BreadcrumbItem>
        <BreadcrumbItem>@_product.Name</BreadcrumbItem>
    </Breadcrumb>
    <GridRow Gutter="32">
        <GridCol Xs="24" Lg="12">
            <Card>
                @if (_product.Images.Count == 0)
                {
                    <Empty Description="@("No images")" />
                }
                else
                {
                    <ImagePreviewGroup>
                        <Space Wrap>
                            @foreach (var (image, index) in _product.Images.OrderBy(i => i.SortOrder).Select((image, index) => (image, index)))
                            {
                                <SpaceItem><Image Src="@image.Url" Width="@(index == 0 ? "100%" : "120px")" /></SpaceItem>
                            }
                        </Space>
                    </ImagePreviewGroup>
                }
            </Card>
        </GridCol>
        <GridCol Xs="24" Lg="12">
            <Space Direction="SpaceDirection.Vertical" Size="SpaceSize.Middle" Style="width: 100%">
                <SpaceItem>
                    <Title Level="2" Style="margin: 0">@_product.Name</Title>
                    @if (_product.Status != ProductStatus.Active)
                    {
                        <Tag Color="@(_product.Status == ProductStatus.Draft ? TagColor.Gold : TagColor.Red)">@_product.Status</Tag>
                    }
                </SpaceItem>
                <SpaceItem><Title Level="3" Type="TextElementType.Success" Style="margin: 0">@_product.Price.ToString("F2")</Title></SpaceItem>
                @if (_product.Description is not null)
                {
                    <SpaceItem><Paragraph>@_product.Description</Paragraph></SpaceItem>
                }
                <SpaceItem>
                    <Descriptions Bordered Column="1" Size="DescriptionsSize.Small">
                        <DescriptionsItem Title="SKU">@_product.Sku</DescriptionsItem>
                        <DescriptionsItem Title="Brand">
                            @_product.Brand?.Name
                            @if (_product.Brand?.Contact is { } contact)
                            {
                                <text> · </text><a href="@contact.Website" target="_blank" rel="noreferrer">@contact.Website</a><text> (@contact.Country)</text>
                            }
                        </DescriptionsItem>
                        <DescriptionsItem Title="Category">@_product.Category?.Name</DescriptionsItem>
                        <DescriptionsItem Title="Availability">
                            @if (_product.InStock)
                            {
                                <Tag Color="TagColor.Green">@_product.Stock in stock</Tag>
                            }
                            else
                            {
                                <Tag>Out of stock</Tag>
                            }
                        </DescriptionsItem>
                        @if (_product.Dimensions is { } size)
                        {
                            <DescriptionsItem Title="Package">@size.WidthCm × @size.HeightCm × @size.DepthCm cm, @size.WeightKg kg</DescriptionsItem>
                        }
                        @if (_product.Tags.Count > 0)
                        {
                            <DescriptionsItem Title="Tags">
                                @foreach (var tag in _product.Tags)
                                {
                                    <Tag>@tag</Tag>
                                }
                            </DescriptionsItem>
                        }
                    </Descriptions>
                </SpaceItem>
                @if (Session.IsEditor)
                {
                    <SpaceItem>
                        <a href="products/@_product.Id/edit"><Button Type="ButtonType.Primary" Icon="edit">Edit</Button></a>
                    </SpaceItem>
                }
            </Space>
        </GridCol>
    </GridRow>
    @if (_related.Count > 0)
    {
        <Card Title="More in this category" Style="margin-top: 24px">
            <AntList DataSource="_related" TItem="RelatedRow">
                <ListItem Extra="@PriceText(context.Price)">
                    <a href="products/@context.Id">@context.Name</a>
                </ListItem>
            </AntList>
        </Card>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? _product;
    private List<RelatedRow> _related = [];
    private bool _loaded;
    private string? _error;

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    protected override Task OnParametersSetAsync() => LoadAsync();

    public void Dispose() => Session.Changed -= OnSessionChanged;

    private void OnSessionChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        try
        {
            var catalog = Session.NewCatalog();
            _product = await catalog.Products
                .AsNoTracking()
                .Include(p => p.Category)
                .Include(p => p.Brand)
                .Include(p => p.Images)
                .FirstOrDefaultAsync(p => p.Id == Id);
            _related = _product is null
                ? []
                : await catalog.Products
                    .Where(p => p.CategoryId == _product.CategoryId && p.Id != _product.Id)
                    .OrderByDescending(p => p.CreatedAt)
                    .Select(p => new RelatedRow(p.Id, p.Name, p.Price))
                    .Take(4)
                    .ToListAsync();
            (_loaded, _error) = (true, null);
        }
        catch (Exception exception) when (exception is RestQueryException or HttpRequestException)
        {
            _error = Errors.Describe(exception);
        }
    }

    private sealed record RelatedRow(int Id, string Name, decimal Price);

    private static RenderFragment PriceText(decimal price) => builder => builder.AddContent(0, price.ToString("F2", System.Globalization.CultureInfo.CurrentCulture));
}
