<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Native AOT isn't possible for a LinqToRest server: EF Core compiles each request's query at run time. ReadyToRun
       precompiles the app instead, for faster startup with nothing given up (publish only; builds are unchanged). -->
  <PropertyGroup>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LinqToRest.Server\LinqToRest.Server.csproj" />
  </ItemGroup>
</Project>
