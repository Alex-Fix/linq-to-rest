{
  "name": "catalog-web",
  "private": true,
  "type": "module",
  "description": "LinqToRest catalog sample in React: run samples/Catalog/Catalog.Api first, then `npm run dev`.",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "npm run format && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "linqtorest": "file:../../../clients/typescript",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
